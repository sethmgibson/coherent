{
  "name": "coherent",
  "version": "0.1.0",
  "description": "Impeccable-style maintainability tooling for backend and large AI-built codebases.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "bin": {
    "coherent": "./dist/cli.js",
    "backend": "./dist/cli.js"
  },
  "exports": {
    "./catalog/rules": "./dist/catalog/rules.js",
    "./catalog/phases": "./dist/catalog/phases.js",
    "./catalog/types": "./dist/catalog/types.js",
    "./finding": "./dist/domain/finding.js"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "generate:skill-docs": "tsx scripts/generate-skill-docs.ts",
    "check:skill-docs": "pnpm generate:skill-docs && git diff --exit-code -- skills/coherent/reference/taxonomy.md skills/coherent/reference/cleanup-phases.md",
    "check:unique-fingerprints": "tsx scripts/check-unique-fingerprints.ts",
    "check:dependencies": "knip --dependencies && knip --dependencies --production --strict",
    "check:security": "pnpm audit --audit-level high",
    "check:package": "tsx scripts/check-package.ts",
    "validate": "pnpm lint && pnpm check:dependencies && pnpm check:security && pnpm test && pnpm typecheck && pnpm check:package && pnpm check:skill-docs && pnpm check:unique-fingerprints",
    "prepack": "pnpm build"
  },
  "keywords": [
    "maintainability",
    "architecture",
    "backend",
    "dead-code",
    "cleanup",
    "ai"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "eslint": "^10.9.1",
    "knip": "6.33.0",
    "publint": "0.3.24",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4"
  }
}
