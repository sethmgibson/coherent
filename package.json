{
  "name": "@aevumvector/coherent",
  "version": "0.2.0",
  "description": "Maintainability skill and CLI for backend and large AI-built TypeScript and Python codebases: find and fix architectural entropy, dead code, and duplicated paths.",
  "type": "module",
  "license": "MIT",
  "author": "Seth Gibson / Aevum Vector",
  "homepage": "https://github.com/sethmgibson/coherent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sethmgibson/coherent.git"
  },
  "bugs": {
    "url": "https://github.com/sethmgibson/coherent/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "bin": {
    "coherent": "./dist/cli.js",
    "backend": "./dist/cli.js"
  },
  "exports": {
    "./catalog/rules": {
      "types": "./dist/catalog/rules.d.ts",
      "default": "./dist/catalog/rules.js"
    },
    "./catalog/phases": {
      "types": "./dist/catalog/phases.d.ts",
      "default": "./dist/catalog/phases.js"
    },
    "./catalog/types": {
      "types": "./dist/catalog/types.d.ts",
      "default": "./dist/catalog/types.js"
    },
    "./finding": {
      "types": "./dist/domain/finding.d.ts",
      "default": "./dist/domain/finding.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "python/*.py",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "generate:skill-docs": "tsx scripts/generate-skill-docs.ts",
    "check:skill-docs": "tsx scripts/generate-skill-docs.ts --check",
    "check:unique-fingerprints": "tsx scripts/check-unique-fingerprints.ts",
    "check:dependencies": "knip --dependencies && knip --dependencies --production --strict",
    "check:security": "pnpm audit --audit-level high",
    "check:package": "tsx scripts/check-package.ts",
    "validate": "pnpm lint && pnpm check:dependencies && pnpm check:security && pnpm test && pnpm typecheck && pnpm check:package && pnpm check:skill-docs && pnpm check:unique-fingerprints",
    "prepack": "node scripts/build.mjs"
  },
  "keywords": [
    "maintainability",
    "architecture",
    "backend",
    "dead-code",
    "cleanup",
    "refactoring",
    "code-quality",
    "static-analysis",
    "typescript",
    "python",
    "cli",
    "ai",
    "ai-agents",
    "agent-skill",
    "cursor",
    "codex"
  ],
  "dependencies": {
    "commander": "^14.0.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "eslint": "^10.9.1",
    "knip": "6.33.0",
    "publint": "0.3.24",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.12"
  }
}
